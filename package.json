{
  "name": "infinitecanvas-engine",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*", "www"],
  "scripts": {
    "dev": "pnpm --filter www dev",
    "build": "pnpm build:wasm && pnpm build:ts",
    "build:wasm": "./build-wasm.sh",
    "build:ts": "pnpm --recursive --filter './packages/**' build",
    "test": "pnpm test:rust && pnpm test:ts",
    "test:rust": "cargo test --all",
    "test:ts": "pnpm --recursive test"
  },
  "packageManager": "pnpm@8.15.0"
}







